# Groq API Key (Primary LLM Engine for Stage 1 Research)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Fallback & Stage 2 Long-Form Report Generator)
GEMINI_API_KEY=your_gemini_api_key_here

# Provider & Model Configuration
# Groq: llama-3.3-70b-versatile (14,000 TPM) / llama-3.1-8b-instant (100,000 TPM)
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini: gemini-3.1-flash-lite (15 RPM, 250K TPM, 500 RPD high-quota model)
GEMINI_RESEARCH_MODEL=gemini-3.1-flash-lite
GEMINI_FINAL_MODEL=gemini-3.1-flash-lite

# Optional Telemetry & Tracing
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=MAS-Research-Agent
